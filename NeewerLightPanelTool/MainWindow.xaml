<Window x:Class="NeewerLightPanelTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unofficial Neewer Bluetooth Light Panel Tool"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="600">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#ccd4df" BorderThickness="1" Padding="10" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="ScanButton" Content="Scan Bluetooth" MinWidth="120" Click="ScanButton_Click" />
                <Button Grid.Column="1" x:Name="ConnectButton" Content="Connect Selected" MinWidth="130" Margin="8,0,0,0" Click="ConnectButton_Click" />
                <Button Grid.Column="2" x:Name="DisconnectButton" Content="Disconnect Selected" MinWidth="145" Margin="8,0,0,0" Click="DisconnectButton_Click" />
                <TextBlock Grid.Column="3" Text="HTTP IP" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox Grid.Column="4" x:Name="InterfaceIpTextBox" Text="127.0.0.1" VerticalAlignment="Center" TextChanged="ServerAddressTextBox_TextChanged" />
                <TextBlock Grid.Column="5" Text="Port" VerticalAlignment="Center" Margin="10,0,6,0" />
                <TextBox Grid.Column="6" x:Name="HttpPortTextBox" Text="5088" VerticalAlignment="Center" TextChanged="ServerAddressTextBox_TextChanged" />
                <Button Grid.Column="7" x:Name="StartStopServerButton" Content="Start HTTP for StreamDeck" MinWidth="95" Margin="8,0,0,0" Click="StartStopServerButton_Click" />
                <TextBlock Grid.Column="8" x:Name="HeaderStatusTextBlock" Text="Scan for NEEWER Bluetooth panels." VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Discovered Lights">
                    <ListBox x:Name="LightsListBox" SelectionMode="Extended" SelectionChanged="LightsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplayId}" Foreground="#555" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BluetoothId}" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Status}" Foreground="#265a88" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <Border Grid.Row="1" BorderBrush="#d7dee8" BorderThickness="1" Padding="10" Margin="0,10,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" x:Name="GroupNameTextBox" Text="New Group" VerticalAlignment="Center" />
                        <Button Grid.Row="0" Grid.Column="1" x:Name="CreateGroupButton" Content="Create Group" MinWidth="105" Margin="8,0,0,0" Click="CreateGroupButton_Click" />
                        <Button Grid.Row="1" Grid.Column="0" x:Name="UseSelectedLightsButton" Content="Use Selected Lights" HorizontalAlignment="Left" MinWidth="125" Margin="0,8,0,0" Click="UseSelectedLightsButton_Click" />
                        <Button Grid.Row="1" Grid.Column="1" x:Name="DeleteGroupButton" Content="Delete Group" MinWidth="105" Margin="8,8,0,0" Click="DeleteGroupButton_Click" />
                        <Button Grid.Row="2" Grid.Column="0" x:Name="LoadGroupsButton" Content="Load Groups" HorizontalAlignment="Left" MinWidth="105" Margin="0,8,0,0" Click="LoadGroupsButton_Click" />
                        <Button Grid.Row="2" Grid.Column="1" x:Name="SaveGroupsButton" Content="Save Groups" MinWidth="105" Margin="8,8,0,0" Click="SaveGroupsButton_Click" />
                    </Grid>
                </Border>

                <GroupBox Grid.Row="2" Header="Groups">
                    <ListBox x:Name="GroupsListBox" SelectionMode="Single" SelectionChanged="GroupsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Status}" Foreground="#265a88" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Mode">
                    <StackPanel Orientation="Horizontal" Margin="12">
                        <RadioButton x:Name="RgbModeRadioButton" Content="RGB" IsChecked="True" GroupName="Mode" Checked="ModeRadioButton_Checked" />
                        <RadioButton x:Name="CctModeRadioButton" Content="CCT Tone" GroupName="Mode" Margin="24,0,0,0" Checked="ModeRadioButton_Checked" />
                        <RadioButton x:Name="SceneModeRadioButton" Content="Scene" GroupName="Mode" Margin="24,0,0,0" Checked="ModeRadioButton_Checked" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Output" Margin="0,12,0,0">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Brightness" VerticalAlignment="Center" />
                        <Slider Grid.Column="1"
                                x:Name="BrightnessSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="39"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="BrightnessSlider_ValueChanged"
                                PreviewMouseLeftButtonUp="ControlSlider_MouseLeftButtonUp"
                                Margin="8,0" />
                        <TextBlock Grid.Column="2" x:Name="BrightnessValueTextBlock" Text="39%" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <Button Grid.Column="3" x:Name="OffButton" Content="Off" MinWidth="70" Margin="16,0,0,0" Click="OffButton_Click" />
                    </Grid>
                </GroupBox>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <GroupBox x:Name="RgbGroupBox" Header="RGB">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Red" VerticalAlignment="Center" />
                            <Slider Grid.Row="0" Grid.Column="1" x:Name="RedSlider" Minimum="0" Maximum="255" Value="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RgbSlider_ValueChanged" PreviewMouseLeftButtonUp="ControlSlider_MouseLeftButtonUp" Margin="8,0" />
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="RedValueTextBlock" Text="255" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" x:Name="ColorPreviewBorder" BorderBrush="#999" BorderThickness="1" Margin="16,0,0,0" Background="#FFFF0000" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Green" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <Slider Grid.Row="1" Grid.Column="1" x:Name="GreenSlider" Minimum="0" Maximum="255" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RgbSlider_ValueChanged" PreviewMouseLeftButtonUp="ControlSlider_MouseLeftButtonUp" Margin="8,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GreenValueTextBlock" Text="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Blue" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="BlueSlider" Minimum="0" Maximum="255" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RgbSlider_ValueChanged" PreviewMouseLeftButtonUp="ControlSlider_MouseLeftButtonUp" Margin="8,10,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="BlueValueTextBlock" Text="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,0,0" />

                            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="PickColorButton" Content="Pick Color" MinWidth="110" HorizontalAlignment="Left" Margin="0,16,0,0" Click="PickColorButton_Click" />
                            <Button Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" x:Name="ApplyRgbButton" Content="Apply RGB" MinWidth="110" HorizontalAlignment="Right" Margin="0,16,0,0" Click="ApplyRgbButton_Click" />
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="CctGroupBox" Header="CCT Tone" Visibility="Collapsed">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tone" VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    x:Name="ToneSlider"
                                    Minimum="3200"
                                    Maximum="5600"
                                    Value="4500"
                                    TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="ToneSlider_ValueChanged"
                                    PreviewMouseLeftButtonUp="ControlSlider_MouseLeftButtonUp"
                                    Margin="8,0" />
                            <TextBlock Grid.Column="2" x:Name="ToneValueTextBlock" Text="4500 K" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="SceneGroupBox" Header="Scenes" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SceneItemsControl" Margin="12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" MinWidth="118" Margin="0,0,8,8" Padding="10,6" Click="SceneButton_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>

                <GroupBox Grid.Row="3" Header="StreamDeck Request" Margin="0,12,0,0">
                    <TextBox x:Name="StreamDeckRequestTextBox"
                             Margin="12"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Background="Transparent"
                             Text="Select a group or one light to generate a StreamDeck URL." />
                </GroupBox>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Text="Ready." TextWrapping="Wrap" />
    </Grid>
</Window>
